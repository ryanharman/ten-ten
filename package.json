{
  "name": "ten-ten",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ten-ten/web dev",
    "build": "pnpm --filter @ten-ten/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fallow": "fallow --coverage coverage/coverage-final.json",
    "test": "vitest run --coverage",
    "bench": "pnpm --filter @ten-ten/core bench",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm fallow"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@vitest/coverage-v8": "^5.0.3",
    "fallow": "^3.31.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
