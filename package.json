{
  "name": "ten-ten",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ten-ten/web dev",
    "build": "pnpm --filter @ten-ten/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fallow": "fallow",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm fallow && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "fallow": "^3.31.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
